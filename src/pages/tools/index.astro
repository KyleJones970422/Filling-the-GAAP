---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
---
<Base title="Free tools" description="Free South African tax and compliance tools: income tax calculator with current SARS tables, public interest score calculator for Companies Act assurance requirements, and the annual tax calendar.">
  <PageHero eyebrow="Free tools" title="Answers in thirty seconds." lede="Built from the same tables and rules I use every day. Free, no sign-up, nothing stored." />
  <section class="section-tight">
    <div class="wrap grid grid-3">
      <a class="card-link" href="/tools/income-tax-calculator"><div class="card"><span class="eyebrow">Individuals</span><h3>Income tax calculator</h3><p>Annual and monthly tax, effective and marginal rates, with rebates, medical credits and retirement contributions.</p></div></a>
      <a class="card-link" href="/tools/pi-score-calculator"><div class="card"><span class="eyebrow">Companies</span><h3>PI score calculator</h3><p>Your public interest score and whether the Companies Act requires an audit, an independent review, or lets you compile your own financial statements.</p></div></a>
      <a class="card-link" href="/resources/tax-calendar"><div class="card"><span class="eyebrow">Everyone</span><h3>Tax calendar</h3><p>Monthly and annual SARS, CIPC, VAT and payroll deadlines.</p></div></a>
    </div>
  </section>
  <CTA />
</Base>
