---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="section">
    <div class="wrap narrow center">
      <span class="eyebrow">404</span>
      <h1>There's a gap here we haven't filled.</h1>
      <p class="lede mx-auto">The page you are looking for does not exist or has moved.</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn-dark" href="/">Home</a>
        <a class="btn btn-outline" href="/services">Services</a>
        <a class="btn btn-outline" href="/contact">Contact</a>
      </div>
    </div>
  </section>
</Base>
