---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site, whatsappLink } from '../config';
const topics = [
  { v: 'personal-tax', l: 'Personal tax' },
  { v: 'business', l: 'Business accounting and tax' },
  { v: 'independent-review', l: 'Independent review or AFS' },
  { v: 'afs', l: 'Annual financial statements' },
  { v: 'payroll', l: 'Payroll' },
  { v: 'cipc', l: 'Company registration or CIPC' },
  { v: 'ftg-books', l: 'FTG Books demo' },
  { v: 'other', l: 'Something else' },
];
---
<Base title="Contact" description="Book a free consultation with Filling the GAAP. WhatsApp, email or the contact form. Fully remote, serving clients across South Africa, Monday to Friday 08:00 to 18:00.">
  <PageHero eyebrow="Contact" title="Let's talk about your numbers." lede="The first consultation is free and there is no obligation. Pick whichever channel suits you." />
  <section class="section-tight">
    <div class="wrap contact-grid">
      <div class="stack">
        <a class="card card-link channel" href={whatsappLink()} target="_blank" rel="noopener">
          <div class="icon" style="background:#dff7e8;color:#128c4a"><svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20Zm4.4-5.9c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.8 1c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.3-2.9c-.2-.3 0-.4.2-.7l.5-.6c.1-.2 0-.3 0-.5l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.9.9-.9 2.1s.9 2.5 1 2.6c.1.2 1.8 2.8 4.4 3.8 1.5.6 2.1.6 2.8.5.5-.1 1.4-.6 1.6-1.2.2-.6.2-1.1.1-1.2l-.4-.3Z"/></svg></div>
          <div><h3>WhatsApp</h3><p class="mb-0">{site.whatsappDisplay}. Fastest for quick questions.</p></div>
        </a>
        <a class="card card-link channel" href={`mailto:${site.email}`}>
          <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></div>
          <div><h3>Email</h3><p class="mb-0">{site.email}</p></div>
        </a>
        <a class="card card-link channel" href={`tel:${site.phoneIntl}`}>
          <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.8 2Z"/></svg></div>
          <div><h3>Phone</h3><p class="mb-0">{site.phoneDisplay}. {site.hours}.</p></div>
        </a>
        <div class="card">
          <h3>Book a consultation</h3>
          {site.bookingUrl ? (
            <>
              <p>Pick a 30-minute slot that suits you.</p>
              <a class="btn btn-primary" href={site.bookingUrl} target="_blank" rel="noopener">Open booking calendar</a>
            </>
          ) : (
            <p class="mb-0">Use the form and tell us a few times that suit you. We will confirm a 30-minute video call within one business day.</p>
          )}
        </div>
        <p class="small muted">{site.location} {site.hours}.</p>
      </div>

      <form class="card" name="contact" method="POST" action="/thank-you" data-netlify="true" netlify-honeypot="company-website" id="contact-form">
        <input type="hidden" name="form-name" value="contact" />
        <p class="hp"><label>Leave this field empty <input name="company-website" tabindex="-1" autocomplete="off" /></label></p>
        <h2 style="font-size:1.5rem">Send a message</h2>
        <div class="field-row">
          <div class="field"><label for="name">Your name</label><input type="text" id="name" name="name" required autocomplete="name" /></div>
          <div class="field"><label for="email">Email</label><input type="email" id="email" name="email" required autocomplete="email" /></div>
        </div>
        <div class="field-row">
          <div class="field"><label for="phone">Phone or WhatsApp</label><input type="tel" id="phone" name="phone" autocomplete="tel" /></div>
          <div class="field">
            <label for="topic">What can we help with?</label>
            <select id="topic" name="topic">{topics.map((t) => <option value={t.v}>{t.l}</option>)}</select>
          </div>
        </div>
        <div class="field">
          <label>I am</label>
          <div class="radio-row">
            <label><input type="radio" name="client_type" value="individual" checked /> An individual</label>
            <label><input type="radio" name="client_type" value="business" /> A business, company or trust</label>
            <label><input type="radio" name="client_type" value="practice" /> An accounting practice</label>
          </div>
        </div>
        <div class="field">
          <label for="message">Tell us a bit about your situation</label>
          <textarea id="message" name="message" required placeholder="What you need, any deadlines, and a few times that suit you for a call."></textarea>
        </div>
        <div class="field">
          <label class="consent"><input type="checkbox" name="consent" required /> <span>I agree to Filling the GAAP storing my details to respond to this enquiry, as described in the <a href="/privacy">privacy policy</a>.</span></label>
        </div>
        <button type="submit" class="btn btn-primary">Send message</button>
        <p class="small muted" style="margin:0.8rem 0 0">We reply within one business day. Please do not send tax numbers, ID numbers or bank details through this form.</p>
      </form>
    </div>
  </section>
</Base>
<script>
  // Pre-select the topic from ?topic= links around the site.
  const t = new URLSearchParams(location.search).get('topic');
  const sel = document.getElementById('topic') as HTMLSelectElement | null;
  if (t && sel && [...sel.options].some((o) => o.value === t)) sel.value = t;
</script>
<style>
  .contact-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 2rem; align-items: start; }
  .channel { display: flex; gap: 1rem; align-items: center; }
  .channel h3 { margin: 0 0 0.2rem; font-size: 1.1rem; }
  .hp { position: absolute; left: -9999px; }
  .consent { display: flex; gap: 0.6rem; align-items: flex-start; font-weight: 500 !important; font-size: 0.9rem; }
  .consent input { margin-top: 0.3rem; }
  @media (max-width: 860px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
