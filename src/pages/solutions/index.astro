---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
import { site } from '../../config';

const products = [
  { name: 'FTG Books', for: 'Small businesses and their accountants', status: 'Live', href: '/solutions/ftg-books', text: 'Cloud accounting built around South African compliance: bank imports, VAT, provisional tax estimates, an automatic PI score, and IFRS for SMEs annual financial statements you can compile yourself when you qualify.', price: 'Free for clients. R149 per company per month for everyone else.' },
  { name: 'Practice Nexus', for: 'Filling the GAAP clients', status: 'Live', href: site.practiceNexusUrl, text: 'Our document management portal: one secure place to upload all the information we need to assist with your financial affairs.', price: 'Access is granted once you have signed up as a client.' },
];
---
<Base title="Solutions" description="Software built by an accountant for South African businesses: FTG Books accounting software and the Practice Nexus document management portal.">
  <PageHero eyebrow="Solutions" title="Software built by an accountant who felt the gaps." lede="We build tools for the parts of accounting and compliance that should be simpler and cheaper than they are." />
  <section class="section-tight">
    <div class="wrap stack">
      {products.map((p) => (
        <a class="card-link" href={p.href} {...(p.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
          <div class="card product">
            <div class="product-main">
              <div class="product-head">
                <h2>{p.name}</h2>
                <span class="pill pill-outline">{p.status}</span>
              </div>
              <p class="muted small">For {p.for}</p>
              <p>{p.text}</p>
              <p class="small"><strong>{p.price}</strong></p>
            </div>
            <div class="product-shot" aria-hidden="true">
              <div class="shot">
                <div class="shot-bar"></div>
                <div class="shot-lines"><span></span><span></span><span></span><span class="short"></span></div>
              </div>
            </div>
          </div>
        </a>
      ))}
      <div><a class="btn btn-primary" href={site.ftgBooksUrl} target="_blank" rel="noopener">Go to FTG Books</a></div>
    </div>
  </section>
  <CTA title="Want a demo?" text="Book a call and we will walk you through FTG Books on your own numbers." />
</Base>
<style>
  .product { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: 2rem; align-items: center; }
  .product-head { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .product-head h2 { margin: 0; font-size: 1.8rem; }
  .shot { background: linear-gradient(160deg, var(--primary), var(--primary-dark)); border-radius: 12px; aspect-ratio: 16/10; padding: 10%; display: flex; flex-direction: column; gap: 10%; }
  .shot-bar { height: 10%; background: var(--accent); border-radius: 4px; width: 40%; }
  .shot-lines { display: flex; flex-direction: column; gap: 8%; flex: 1; }
  .shot-lines span { display: block; height: 10%; background: var(--line-on-dark); border-radius: 3px; }
  .shot-lines .short { width: 60%; }
  @media (max-width: 760px) { .product { grid-template-columns: 1fr; } .product-shot { max-width: 320px; } }
</style>
