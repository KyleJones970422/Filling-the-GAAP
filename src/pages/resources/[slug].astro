---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../../config';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-ZA', { day: 'numeric', month: 'long', year: 'numeric' });
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  author: { '@type': 'Person', name: site.owner },
  publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: `${site.url}/logo.svg` } },
  mainEntityOfPage: `${site.url}/resources/${post.id}`,
};
---
<Base title={post.data.title} description={post.data.description} type="article" jsonLd={ld}>
  <article>
    <header class="section-tight post-head">
      <div class="wrap narrow">
        <p class="crumbs"><a href="/resources">Resources</a> / {post.data.category}</p>
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
        <p class="byline">By {site.owner} · <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>{post.data.updated && <> · Updated {fmt(post.data.updated)}</>}</p>
      </div>
    </header>
    <div class="section-tight">
      <div class="wrap narrow prose">
        <Content />
        <hr />
        <p class="small muted">This article is general information, current at the date of publication, and not advice. Tax law and SARS practice change; please confirm the position for your own circumstances or <a href="/contact">book a consultation</a>.</p>
        {post.data.tags.length > 0 && <p>{post.data.tags.map((t) => <span class="pill pill-outline">{t}</span>)}</p>}
      </div>
    </div>
  </article>
  <CTA title="Want this handled for you?" text="Book a free consultation and let's talk about your specific situation." />
</Base>
<style>
  .post-head { padding-top: clamp(2.5rem, 6vw, 4rem); }
  .post-head h1 { font-size: clamp(1.9rem, 4vw, 2.9rem); }
  .crumbs { font-size: 0.85rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700; }
  .byline { color: var(--muted); font-size: 0.92rem; }
</style>
